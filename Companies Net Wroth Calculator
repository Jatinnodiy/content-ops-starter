<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statutory Net Worth Calculator (Structured Sub-Heads - Final)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Roboto+Mono:wght@400;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1f2937;
        }
        
        .input-field {
            @apply w-full p-3 border border-gray-300 rounded-lg transition-all text-right font-mono text-lg bg-white;
        }
        
        .input-field:focus {
            @apply outline-none border-indigo-500 ring-2 ring-indigo-200;
        }

        .sub-head {
            @apply pl-6 border-l-4 border-gray-300 ml-4;
        }
        
        .explanation-box { @apply p-2 mt-1 mb-3 text-xs rounded-lg shadow-inner; }
        .inclusion-info { @apply border-l-4 border-green-500 bg-green-50 text-green-800; }
        .exclusion-info { @apply border-l-4 border-red-500 bg-red-50 text-red-800; }
        
        .net-worth-positive { @apply bg-green-100 text-green-900 border-green-500; }
        .net-worth-negative { @apply bg-red-100 text-red-900 border-red-500; }
        .net-worth-zero { @apply bg-gray-100 text-gray-900 border-gray-400; }
        
        .major-head-label { @apply font-bold text-lg text-gray-800 mb-2; }
        .sub-head-label { @apply font-medium text-gray-700; }
    </style>
</head>
<body class="p-4 md:p-8">

    <div class="max-w-5xl mx-auto bg-white shadow-2xl rounded-xl p-6 md:p-10 border border-gray-200">
        
        <header class="text-center mb-8">
            <h1 class="text-3xl md:text-4xl font-extrabold text-indigo-700 mb-2">
                Statutory Net Worth Calculator (Detailed Breakdown)
            </h1>
            <p class="text-lg text-gray-600">
                Mandatory Calculation as per Companies Act, 2013 | Section 2(57)
            </p>
        </header>

        <div class="grid lg:grid-cols-2 gap-8">
            
            <!-- ===== PART A: INCLUSIONS (Additions) ===== -->
            <div class="space-y-6 p-5 bg-green-50 rounded-xl border border-green-200 shadow-md">
                <h2 class="text-2xl font-bold text-green-700 border-b pb-2 border-green-300">
                    PART A: Statutory Inclusions (Additions)
                </h2>

                <!-- 1. Paid-up Share Capital -->
                <div class="space-y-2">
                    <p class="major-head-label">1. Paid-up Share Capital</p>
                    
                    <div class="sub-head space-y-4">
                        <!-- 1(a) Equity Capital -->
                        <div>
                            <label for="equityCapital" class="sub-head-label block">1(a) Equity Share Capital (Fully Paid)</label>
                            <input type="number" id="equityCapital" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box inclusion-info">
                                <strong class="text-green-900">Include:</strong> Value of fully paid Equity Shares.
                            </div>
                        </div>

                        <!-- 1(b) Preference Capital -->
                        <div>
                            <label for="preferenceCapital" class="sub-head-label block">1(b) Preference Share Capital (Fully Paid)</label>
                            <input type="number" id="preferenceCapital" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box inclusion-info">
                                <strong class="text-green-900">Include:</strong> Value of fully paid Preference Shares.
                            </div>
                        </div>

                        <!-- 1(c) Excluded Capital Items - INFORMATION ONLY -->
                        <div>
                            <p class="sub-head-label block text-red-700 font-bold">1(c) EXCLUDED Capital Items (Do Not Include):</p>
                            <div class="explanation-box exclusion-info">
                                <strong class="text-red-900">Explicitly Excluded:</strong> Share Forfeiture Account balance, Share Application Money pending allotment, Call-in-Advance (if shown separately).
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Reserves from Profits -->
                <div class="space-y-2 pt-4 border-t border-green-300">
                    <p class="major-head-label">2. Reserves and Surplus (Only Reserves available for distribution)</p>
                    
                    <div class="sub-head space-y-4">
                        
                        <!-- 2(a) Securities Premium -->
                        <div>
                            <label for="securitiesPremium" class="sub-head-label block">2(a) Securities Premium Account</label>
                            <input type="number" id="securitiesPremium" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box inclusion-info">
                                <strong class="text-green-900">Include:</strong> Always included.
                            </div>
                        </div>

                        <!-- 2(b) General/P&L Reserve -->
                        <div>
                            <label for="profitReserves" class="sub-head-label block">2(b) General Reserve / P&L Credit Balance / Free Reserves</label>
                            <input type="number" id="profitReserves" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box inclusion-info">
                                <strong class="text-green-900">Include:</strong> General Reserve, P&L Credit Surplus, Capital Reserve (realized), etc.
                            </div>
                        </div>
                        
                        <!-- 2(c) Capital Redemption Reserve -->
                        <div>
                            <label for="crr" class="sub-head-label block">2(c) Capital Redemption Reserve (CRR) & DRR</label>
                            <input type="number" id="crr" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box inclusion-info">
                                <strong class="text-green-900">Include:</strong> Statutory reserves created from profits (Capital Redemption Reserve and Debenture Redemption Reserve).
                            </div>
                        </div>

                        <!-- 2(d) EXCLUDED RESERVES - INFORMATION ONLY -->
                        <div>
                            <p class="sub-head-label block text-red-700 font-bold">2(d) EXCLUDED Reserves (Do Not Include):</p>
                            <div class="explanation-box exclusion-info">
                                <strong class="text-red-900">Explicitly Excluded:</strong> Revaluation Reserve, Reserves from Write-back of Depreciation, Amalgamation Reserve (if non-profit related).
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-6 p-4 bg-green-100 rounded-lg border-2 border-green-600">
                    <p class="text-xl font-bold text-green-800 flex justify-between items-center">
                        Total Statutory Inclusions (A): 
                        <span id="totalInclusions" class="font-mono text-2xl">₹ 0</span>
                    </p>
                </div>
            </div>

            <!-- ===== PART B: DEDUCTIONS (Subtractions) ===== -->
            <div class="space-y-6 p-5 bg-red-50 rounded-xl border border-red-200 shadow-md">
                <h2 class="text-2xl font-bold text-red-700 border-b pb-2 border-red-300">
                    PART B: Statutory Deductions
                </h2>

                <!-- 3. Accumulated Losses -->
                <div class="space-y-2">
                    <p class="major-head-label">3. Accumulated Losses (Debit Balance of P&L)</p>
                    
                    <div class="sub-head space-y-4">
                        <div>
                            <label for="accumulatedLosses" class="sub-head-label block">3(a) P&L Account (Debit Balance)</label>
                            <input type="number" id="accumulatedLosses" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box deduction-info">
                                <strong class="text-red-900">Deduct:</strong> Enter the positive absolute value of the unadjusted loss.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Fictitious Assets / Deferred Expenditure -->
                <div class="space-y-2 pt-4 border-t border-red-300">
                    <p class="major-head-label">4. Fictitious Assets / Deferred Expenditure (Unwritten)</p>
                    
                    <div class="sub-head space-y-4">
                        
                        <!-- 4(a) Deferred Revenue Expenditure -->
                        <div>
                            <label for="deferredExpenditure" class="sub-head-label block">4(a) Deferred Revenue Expenditure (e.g., R&D, Ad campaigns)</label>
                            <input type="number" id="deferredExpenditure" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box deduction-info">
                                <strong class="text-red-900">Deduct:</strong> Portion not yet written off to the P&L.
                            </div>
                        </div>
                        
                        <!-- 4(b) Miscellaneous Expenditure -->
                        <div>
                            <label for="miscellaneousExpenditure" class="sub-head-label block">4(b) Miscellaneous Expenditure (e.g., Preliminary Expenses)</label>
                            <input type="number" id="miscellaneousExpenditure" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box deduction-info">
                                <strong class="text-red-900">Deduct:</strong> Unwritten portion of Preliminary, Share/Debenture Issue Expenses.
                            </div>
                        </div>

                        <!-- 4(c) Deferred Tax Assets (Net) -->
                        <div>
                            <label for="netDTA" class="sub-head-label block">4(c) Deferred Tax Assets (Net DTA)</label>
                            <input type="number" id="netDTA" class="input-field" value="0" oninput="calculateNetWorth()">
                            <div class="explanation-box deduction-info">
                                <strong class="text-red-900">Deduct:</strong> Often treated as a deduction unless specifically advised otherwise, due to its non-cash nature.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-6 p-4 bg-red-100 rounded-lg border-2 border-red-600">
                    <p class="text-xl font-bold text-red-800 flex justify-between items-center">
                        Total Statutory Deductions (B): 
                        <span id="totalDeductions" class="font-mono text-2xl">₹ 0</span>
                    </p>
                </div>
            </div>
            
        </div>
        
        <!-- ===== NET WORTH RESULT ===== -->
        <div class="mt-10 p-6 md:p-8 rounded-xl border-4 shadow-xl text-center transition-all duration-500" id="netWorthResultBox">
            <h3 class="text-2xl font-bold mb-2">
                Calculated Statutory Net Worth (A - B)
            </h3>
            <p id="netWorthResult" class="font-mono text-5xl font-extrabold"></p>
            <p id="resultStatus" class="mt-2 text-lg font-semibold"></p>
        </div>
        
    </div>

    <script>
        // Formats the number as Indian Rupee (INR) without decimals
        const currencyFormat = new Intl.NumberFormat('en-IN', {
            style: 'currency',
            currency: 'INR',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
        });

        // Main calculation function
        function calculateNetWorth() {
            // Helper function to safely parse input values
            const getNum = (id) => parseFloat(document.getElementById(id).value) || 0;

            // --- PART A: STATUTORY INCLUSIONS ---
            // 1. Capital (Equity + Preference)
            const equityCapital = getNum('equityCapital');
            const preferenceCapital = getNum('preferenceCapital');
            
            // 2. Reserves from Profits (Securities Premium + Free Reserves + Statutory Reserves)
            const securitiesPremium = getNum('securitiesPremium');
            const profitReserves = getNum('profitReserves');
            const crr = getNum('crr');
            
            const totalInclusions = equityCapital + preferenceCapital + securitiesPremium + profitReserves + crr;

            // --- PART B: STATUTORY DEDUCTIONS ---
            // 3. Accumulated Losses
            const accumulatedLosses = getNum('accumulatedLosses');
            
            // 4. Fictitious Assets / Deferred Expenditure
            const deferredExpenditure = getNum('deferredExpenditure');
            const miscellaneousExpenditure = getNum('miscellaneousExpenditure');
            const netDTA = getNum('netDTA');
            
            const totalDeductions = accumulatedLosses + deferredExpenditure + miscellaneousExpenditure + netDTA;
            
            // --- NET WORTH CALCULATION ---
            const netWorth = totalInclusions - totalDeductions;
            
            // --- UPDATE UI ---
            document.getElementById('totalInclusions').textContent = currencyFormat.format(totalInclusions);
            document.getElementById('totalDeductions').textContent = currencyFormat.format(totalDeductions);
            
            const resultBox = document.getElementById('netWorthResultBox');
            const netWorthDisplay = document.getElementById('netWorthResult');
            const resultStatus = document.getElementById('resultStatus');
            
            // Reset classes
            resultBox.classList.remove('net-worth-positive', 'net-worth-negative', 'net-worth-zero');
            netWorthDisplay.classList.remove('text-green-600', 'text-red-600', 'text-gray-600');
            
            netWorthDisplay.textContent = currencyFormat.format(netWorth);

            if (netWorth > 0) {
                resultBox.classList.add('net-worth-positive');
                netWorthDisplay.classList.add('text-green-600');
                resultStatus.textContent = 'STATUS: POSITIVE NET WORTH (Meets Thresholds)';
            } else if (netWorth < 0) {
                resultBox.classList.add('net-worth-negative');
                netWorthDisplay.classList.add('text-red-600');
                resultStatus.textContent = 'STATUS: NEGATIVE NET WORTH (Potential Compliance Risk)';
            } else {
                resultBox.classList.add('net-worth-zero');
                netWorthDisplay.classList.add('text-gray-600');
                resultStatus.textContent = 'STATUS: ZERO NET WORTH';
            }
        }
        
        // Initialize the calculation on page load
        window.onload = function() {
            calculateNetWorth();
        };
    </script>
</body>
</html> 
 
